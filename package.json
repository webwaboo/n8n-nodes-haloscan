{
  "name": "n8n-nodes-haloscan",
  "version": "2.0.11",
  "description": "Haloscan is a powerful SEO analysis tool that provides insights into keyword rankings, domain metrics, and related searches.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://n8n.io",
  "author": {
    "name": "johan.b",
    "email": "bj.brunojohan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webwaboo/n8n-nodes-haloscan.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node prerelease",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/HaloscanApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Haloscan/Haloscan.node.js",
      "dist/nodes/Haloscan/v2/HaloscanV2.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@n8n/node-cli": "^0.23.1",
    "eslint": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.6",
    "globals": "^15.15.0",
    "prettier": "^3.3.2",
    "release-it": "^19.2.4",
    "typescript": "^5.5.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
